# Botanical release. Copy to .env and edit. Never commit or share .env.

# Login for the web client. Change this.
BOTANICAL_PASSWORD=change-me
# BOTANICAL_PASSWORD_HASH=   # bun -e 'console.log(await Bun.password.hash("..."))'
# Signs the session cookie. Set 16+ random characters before exposing the port.
BOTANICAL_SESSION_SECRET=
BOTANICAL_DEPLOYMENT_MODE=SELF_HOST
BOTANICAL_PUBLIC_ORIGIN=http://localhost:3000
BOTANICAL_COOKIE_SECURE=false
BOTANICAL_TRUST_PROXY=true

# Postgres from docker-compose.yml (host port 5433). Unset for an in-memory store.
POSTGRES_USER=botanical
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=botanical
POSTGRES_PORT=5433
DATABASE_URL=postgresql://botanical:change-me-postgres@127.0.0.1:5433/botanical

# API listen address. The web build proxies /api to http://127.0.0.1:8787.
BOTANICAL_HOST=127.0.0.1
BOTANICAL_PORT=8787
# Web listen address.
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Files and shell tools are jailed here (default ./data).
# BOTANICAL_WORKSPACE=
# BOTANICAL_MCP_CONFIG=     # default ./config/mcp.json (no servers)
# BOTANICAL_PROFILES=
LOG_LEVEL=info

# Model provider keys. Server-side only. A set key lists that provider's profiles.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Built-in web search. Optional.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=
