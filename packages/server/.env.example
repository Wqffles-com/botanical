# Postgres. Omit to run with in-memory state (not durable).
DATABASE_URL=postgres://botanical:botanical@localhost:5432/botanical

# Apply packages/server/sql/001_runtime.sql on startup. Set to 0 when packages/db migrates.
BOTANICAL_AUTO_MIGRATE=1

PORT=8787
HOST=0.0.0.0

# Delivery worker poll. Clients can also POST /api/a2a/poll.
A2A_POLL_MS=1000

# Optional JSON files. See packages/server/examples/.
BOTANICAL_AGENTS_FILE=
BOTANICAL_MCP_CONFIG=

# Opt-in dev brain. Clients must still send profileId (default id: echo).
# This is not a default profile.
BOTANICAL_DEV_PROVIDER=
BOTANICAL_ECHO_PROFILE=echo

# Positive integer. Defaults to 8.
BOTANICAL_MAX_STEPS=
