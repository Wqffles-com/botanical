# Botanical server. Copy to packages/server/.env — never commit .env.

# SELF_HOST (default) or SAAS. v0 uses one code path; this flag is branding and config.
BOTANICAL_DEPLOYMENT_MODE=SELF_HOST

# Optional display name.
# Defaults: "Botanical" for SELF_HOST, "Botanical Cloud" for SAAS.
# BOTANICAL_BRAND_NAME=Botanical

# Required: one of these. When both are set, the argon2 hash is used.
BOTANICAL_PASSWORD=change-me
# Generate: bun -e 'console.log(await Bun.password.hash("change-me"))'
# BOTANICAL_PASSWORD_HASH=

# Listen address. PORT is the container convention; BOTANICAL_PORT wins when set.
BOTANICAL_HOST=0.0.0.0
PORT=8787

# Session cookie lifetime in seconds (60 through 31536000). Default 14 days.
# BOTANICAL_SESSION_TTL_SECONDS=1209600

# Send the session cookie with Secure. Set true behind HTTPS.
BOTANICAL_COOKIE_SECURE=false

# Browser origin allowed to call the API with credentials (no path).
# Example: http://localhost:5173
# BOTANICAL_CORS_ORIGIN=

# Trust X-Forwarded-For for login rate limits when a reverse proxy terminates the client.
BOTANICAL_TRUST_PROXY=false

# Postgres. When set, startup requires packages/db (createStore). Missing package fails closed.
# Unset DATABASE_URL to use the in-memory store (dev and tests; data dies with the process).
# DATABASE_URL=postgres://botanical:botanical@localhost:5432/botanical

# JSON array of model profiles. Nothing is selected by default — the client must pass profileId.
# Do not put API keys in this JSON.
# BOTANICAL_PROFILES=[{"id":"grok","name":"Grok","provider":"xai","model":"grok-4"},{"id":"fast","name":"Fast","provider":"deepseek","model":"deepseek-chat"}]

# Max JSON body size in bytes. Default 1000000.
# BOTANICAL_MAX_BODY_BYTES=1000000

# Claude Desktop MCP config ({ "mcpServers": { ... } }). Paths are relative to the
# process working directory. A missing file is reported on GET /api/mcp/servers.
# See config/mcp.example.json for a local echo fixture.
# BOTANICAL_MCP_CONFIG=config/mcp.example.json
# BOTANICAL_MCP_DISABLED=false

# Server-side provider keys. The v0 message route does not call providers yet.
# Keys are never accepted from the web client.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
