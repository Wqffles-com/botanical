# Deployment mode only. See docs/BUSINESS_MODEL.md.
# Copy the variables you need into the process environment. Do not commit secrets.

# self-host (default) | saas
# Aliases: self_host, SELF_HOST, oss, hosted
BOTANICAL_DEPLOYMENT_MODE=self-host

# Self-host only. Set exactly one.
# Plaintext passcode:
BOTANICAL_PASSWORD=change-me
# Or SHA-256 of the passcode with no trailing newline:
# printf '%s' 'change-me' | sha256sum | awk '{print "sha256:"$1}'
# BOTANICAL_PASSWORD_HASH=sha256:<64 hex chars>

# Not read in v0. Self-host tenant id is "self".
# SaaS tenant id is the placeholder "placeholder" until real tenancy ships.
# BOTANICAL_TENANT_ID=
