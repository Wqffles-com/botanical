# Copy to packages/db/.env for local migrate. Do not commit real secrets.

# Postgres connection. The value is a URL, not a model API key.
DATABASE_URL=postgres://botanical:botanical@127.0.0.1:5432/botanical

# self_host (OSS default) or saas. Blank falls back to settings, then self_host.
# SELF_HOST and SAAS are accepted and normalized to self_host / saas.
DEPLOYMENT_MODE=self_host

# Self-host login secret. Set the raw passcode OR a precomputed hash, not both required.
# Postgres stores these variable NAMES, never the values.
BOTANICAL_PASSWORD=change-me
# Alias accepted by deploy config. Same meaning as BOTANICAL_PASSWORD.
# BOTANICAL_PASSCODE=change-me
# BOTANICAL_PASSWORD_HASH=

# Provider keys stay in the server environment. See secret_refs.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
