{
  "name": "@botanical/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Botanical Postgres schema, Drizzle client, and migrations.",
  "engines": {
    "bun": ">=1.1.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/bun": "^1.2.21",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  }
}
