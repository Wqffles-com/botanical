{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@botanical/ui/components/*": ["./src/components/*.tsx"],
      "@botanical/ui/hooks/*": ["./src/hooks/*.ts"],
      "@botanical/ui/lib/*": ["./src/lib/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
