# Botanical environment. Copy to .env and edit. Never commit .env.
#   cp .env.example .env
#
# Compose project botanical-mvp. Host ports below stay off the other
# Botanical stack (web 8080 / API 8787 / Postgres 5432).

COMPOSE_PROJECT_NAME=botanical-mvp

# SELF_HOST: one operator, one passcode, your machine or VPS.
# SAAS: the same images on Botanical-operated hosts. v0 is still single-tenant.
# self_host / saas (any case, hyphen or underscore) are accepted at container start
# and normalized to SELF_HOST or SAAS for the API.
DEPLOYMENT_MODE=SELF_HOST
# Leave empty to follow DEPLOYMENT_MODE.
BOTANICAL_DEPLOYMENT_MODE=

# Web → server gate. The API reads BOTANICAL_PASSWORD or BOTANICAL_PASSWORD_HASH.
# When those are empty, the container entrypoint copies BOTANICAL_PASSCODE into
# BOTANICAL_PASSWORD. Use one secret. Change it before anyone else can reach the port.
BOTANICAL_PASSCODE=change-me-passcode
BOTANICAL_PASSWORD=
# Argon2 hash from `bun -e 'console.log(await Bun.password.hash("change-me-passcode"))'`.
# When set, it wins over the plaintext password.
# BOTANICAL_PASSWORD_HASH=

# Signs the session cookie. Required for a real SaaS host (16+ characters, not this example).
# Self-host can leave it empty; set one before the port is shared.
BOTANICAL_SESSION_SECRET=change-me-session-secret

# Public web origin, no path and no trailing slash. Set BOTANICAL_COOKIE_SECURE=true on https.
BOTANICAL_PUBLIC_ORIGIN=http://localhost:3000
BOTANICAL_COOKIE_SECURE=false
# BOTANICAL_SESSION_TTL_SECONDS=1209600
# BOTANICAL_BRAND_NAME=Botanical

# true when Next (or another proxy) sits in front of the API.
BOTANICAL_TRUST_PROXY=true
# Set only if the browser calls the API on a different origin than the page.
# BOTANICAL_CORS_ORIGIN=http://localhost:3000

# Bundled Postgres. The hostname inside DATABASE_URL is the Compose service
# `postgres`, port 5432 on that network. POSTGRES_PORT is the host port only.
# If you change POSTGRES_PASSWORD, put the same password in DATABASE_URL
# (URL-encode it: @ → %40).
POSTGRES_USER=botanical
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=botanical
POSTGRES_PORT=5433
DATABASE_URL=postgresql://botanical:change-me-postgres@postgres:5432/botanical
# DATABASE_SSL=require
# DATABASE_POOL_MAX=4

# Host publish ports. The API process listens on 8787 inside the container.
# Next listens on 3000 inside the container and, by default, on 3000 on the host.
SERVER_PORT=8788
WEB_PORT=3000
WEB_BIND=0.0.0.0

# Next.js rewrite target. Used when the web image is built.
# http://server:8787 is the Compose network. Local `bun run dev` should leave
# this unset so Next proxies to http://127.0.0.1:8787.
# BOTANICAL_API_URL=http://server:8787

# File-tool workspace inside the server container (volume botanical_workspace).
BOTANICAL_WORKSPACE=/data

# MCP. Compose mounts BOTANICAL_MCP_CONFIG_FILE at /config/mcp.json (read-only).
# The default file has no servers and no secrets. See docs/DEPLOY.md.
BOTANICAL_MCP_CONFIG=/config/mcp.json
BOTANICAL_MCP_CONFIG_FILE=./config/mcp.json
# Inline JSON overrides the file when set. Same shape as config/mcp.json.
# BOTANICAL_MCP_SERVERS=
# BOTANICAL_MCP_DISABLED=0
# BOTANICAL_MCP_CONNECT_TIMEOUT_MS=15000
# BOTANICAL_MCP_TOOL_TIMEOUT_MS=60000

# Available model profiles. Nothing is selected for you; each chat picks one.
# Do not put API keys in this JSON. `mock` needs no provider key.
BOTANICAL_PROFILES=[{"id":"mock","name":"Mock echo","provider":"mock","model":"echo"}]

# debug | info | warn | error
LOG_LEVEL=info

# Image pins. Digest-pin these on a host you do not rebuild often.
BUN_IMAGE=oven/bun:1.4.2-alpine
NODE_IMAGE=node:22-alpine

# Model provider keys. Server-side only. Leave blank to leave that provider off.
# GET /api/profiles lists providers whose key is set, plus mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# OpenAI-compatible endpoint (local models, proxies, another host).
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# Built-in web search. Not required to boot.
# BOTANICAL_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=
SEARXNG_API_KEY=

# Secret files (Docker secrets, a mounted file). A non-empty plain value wins.
# An empty file is an error where the server reads *_FILE.
# BOTANICAL_PASSCODE_FILE=
# BOTANICAL_PASSWORD_FILE=
# DATABASE_URL_FILE=
# BOTANICAL_SESSION_SECRET_FILE=
# OPENAI_API_KEY_FILE=

# --- Reserved. Not a billing integration. ---
# Multi-tenant accounts and subscription billing are deferred.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
