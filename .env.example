# Copy to .env for local self-host. Never commit .env.
# Deployment mode: self-host (default) or saas. Same codebase.
BOTANICAL_MODE=self-host

# Web → server password. Auth is not enforced in the scaffold.
BOTANICAL_PASSWORD=changeme
# Later option, not read yet: BOTANICAL_PASSWORD_HASH=

PORT=8787

# Local Postgres from docker compose (host port). Change before any shared deploy.
DATABASE_URL=postgres://botanical:botanical@localhost:5432/botanical

# Server-side model keys only. The web client must never send these.
# PROVIDER_OPENAI_API_KEY=
# PROVIDER_ANTHROPIC_API_KEY=
# PROVIDER_XAI_API_KEY=
# PROVIDER_DEEPSEEK_API_KEY=
# PROVIDER_OPENROUTER_API_KEY=
