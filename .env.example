# Botanical environment. Copy to .env and edit. Never commit .env.
#   cp .env.example .env
#
# Any key below may also be supplied as <NAME>_FILE pointing at a secret file
# (Docker secrets, Kubernetes). A non-empty plain value wins over the file.

# self_host: one operator, one passcode, your machine or VPS.
# saas: the same images on Botanical-operated hosts. v0 is still single-tenant;
# multi-tenant accounts and billing are deferred. See docs/DEPLOY.md.
DEPLOYMENT_MODE=self_host

# Web → server gate. The HTTP API reads BOTANICAL_PASSWORD (or BOTANICAL_PASSWORD_HASH).
# Compose defaults this to "botanical" when unset. Change it before any shared deploy.
BOTANICAL_PASSWORD=botanical
BOTANICAL_PASSCODE=botanical

# There is no silent default model. GET /api/profiles always includes `mock`
# (local echo + file_list) plus one profile per provider whose key is set.
# The client must send profileId on every chat and message.
# Optional override (replaces the built-in one-profile-per-provider list).
# Profiles for providers without a key are omitted. Do not put API keys in this JSON.
# BOTANICAL_PROFILES_FILE=./profiles.json
# BOTANICAL_PROFILES=[{"id":"grok","name":"Grok","provider":"xai","model":"grok-4"}]
BOTANICAL_DEPLOYMENT_MODE=SELF_HOST

# Signs the session cookie. Required in saas. Recommended everywhere.
# Self-host derives one from the passcode when this is empty.
BOTANICAL_SESSION_SECRET=change-me-session-secret

# Public web origin, no trailing slash. https:// turns on Secure cookies (COOKIE_SECURE=auto).
BOTANICAL_PUBLIC_ORIGIN=http://localhost:8080
# COOKIE_SECURE=auto

# Bundled Postgres (Compose service name: postgres).
# If you change POSTGRES_PASSWORD, change the password inside DATABASE_URL to match.
# Host is `postgres` on the Compose network, not localhost.
POSTGRES_USER=botanical
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=botanical
POSTGRES_PORT=5432
DATABASE_URL=postgresql://botanical:change-me-postgres@postgres:5432/botanical
# DATABASE_SSL=require
# DATABASE_POOL_MAX=4
# USE_BUNDLED_DATABASE=1

# Host ports. Postgres and the API bind on 127.0.0.1. The web UI publishes WEB_BIND.
SERVER_PORT=8787
WEB_PORT=8080
WEB_BIND=0.0.0.0

# Image targets: runtime-bun (default) or runtime-node.
# Web: runtime-nginx (default), runtime-bun, or runtime-node.
SERVER_RUNTIME=runtime-bun
WEB_RUNTIME=runtime-nginx
BUN_IMAGE=oven/bun:1.4-alpine
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine

# Set to 1 to serve the web files from the server process and skip the web container:
#   SERVE_WEB=1 docker compose up --build postgres server
SERVE_WEB=0

# File-tool workspace inside the server container (Compose volume botanical_workspace).
BOTANICAL_WORKSPACE=/data

# debug | info | warn | error
LOG_LEVEL=info

# 1 behind the bundled nginx (or another reverse proxy). 0 if clients hit the server directly.
TRUST_PROXY=1

# Model provider keys. Server-side only. Leave blank to hide that provider.
# A set key adds one profile. It does not select a model for new chats.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# OpenAI-compatible host (Ollama, vLLM, proxies). Both values are required
# before that profile is listed. OPENAI_COMPAT_MODEL overrides the model id
# (otherwise "default"). CUSTOM_OPENAI_* is still accepted when the matching
# OPENAI_COMPAT_* variable is unset.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# CUSTOM_OPENAI_BASE_URL=
# CUSTOM_OPENAI_API_KEY=

# Optional keys for the built-in web search tool. Not required to boot.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Set to 1 to keep running the deploy bootstrap even after packages/server lands in the image.
# BOTANICAL_FORCE_BOOTSTRAP=0

# --- Reserved for hosted ops. Not read as a billing integration in v0. ---
# Multi-tenant auth and subscription billing are deferred. Do not point a live
# payment provider at this process until that work exists.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
